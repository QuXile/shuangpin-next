{
  "name": "shuangpin-next",
  "version": "1.5.1",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "双拼 NEXT：面向全拼熟练者的结构化双拼学习应用",
  "packageManager": "pnpm@11.28.5",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @shuangpin/web dev",
    "build": "pnpm --filter @shuangpin/web build",
    "preview": "pnpm --filter @shuangpin/web preview",
    "test": "pnpm --filter @shuangpin/core test && pnpm --filter @shuangpin/web test",
    "test:watch": "pnpm --filter @shuangpin/core test:watch",
    "typecheck": "pnpm --filter @shuangpin/core typecheck && pnpm --filter @shuangpin/web typecheck",
    "verify": "pnpm typecheck && pnpm lint:ui && pnpm data:sync && pnpm test && pnpm build && pnpm validate",
    "validate": "node scripts/validate-all.mjs",
    "data:lexicon": "node scripts/build-lexicon.mjs",
    "data:sync": "node scripts/sync-data.mjs",
    "lint:ui": "node scripts/check-ui-conventions.mjs"
  },
  "devDependencies": {
    "pinyin-pro": "3.29.5",
    "typescript": "^5.9.3"
  }
}
