    {
      "id": "L1.1",
      "chapterId": "ch-intro",
      "kind": "intro",
      "title": "入门 · 认识双拼",
      "desc": "一声母一韵母两键；键位图；三行卡；先看单字、再练词语",
      "focusAtoms": []
    },
    {
      "id": "L2.1",
      "chapterId": "ch-basic",
      "kind": "drill",
      "title": "声母 · zh",
      "desc": "新键：zh。先练单字，再练词语",
      "focusAtoms": [
        "initial:zh"
      ],
      "tips": [
        "遇到多音字按词语读音取键；j/q/x/y 后的 ü 写作 u，仍按 U 键，如「去」= QU。",
        "翘舌三定：zh / ch / sh 被放在三个低频键上；本方案 zh = V。"
      ],
      "passCriteria": {
        "accuracy": 0.85,
        "mode": "accuracy"
      }
    },
    {
      "id": "L2.2",
      "chapterId": "ch-basic",
      "kind": "drill",
      "title": "声母 · ch",
      "desc": "新键：ch。注意 i/u/v 键的双重身份",
      "focusAtoms": [
        "initial:ch"
      ],
      "tips": [
        "翘舌三定：zh / ch / sh 被放在三个低频键上；本方案 ch = I。"
      ],
      "passCriteria": {
        "accuracy": 0.85,
        "mode": "accuracy"
      }
    },
    {
      "id": "L2.3",
      "chapterId": "ch-basic",
      "kind": "drill",
      "title": "声母 · sh",
      "desc": "新键：sh。声母部分完成，先单字后词语",
      "focusAtoms": [
        "initial:sh"
      ],
      "tips": [
        "翘舌三定：zh / ch / sh 被放在三个低频键上；本方案 sh = U。"
      ],
      "passCriteria": {
        "accuracy": 0.85,
        "mode": "accuracy"
      }
    },
